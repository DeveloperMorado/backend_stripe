# Local secrets and settings for stripebackend. Copy to .env and fill in real values.
# Spring Boot loads it via spring.config.import in application.properties.

# Stripe (replace with your new key after rolling it in the Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_your_key_here

# DynamoDB (local DynamoDB on port 8000; dummy credentials are fine locally)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_CUSTOMER_TABLE_NAME=UserAccount
